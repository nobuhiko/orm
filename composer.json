{
    "name": "nobuhiko/orm",
    "type": "library",
    "description": "Doctrine ORM 2.4.8 running clean on PHP 7.4, for EC-CUBE 3.0.x",
    "keywords": [
        "orm",
        "database"
    ],
    "homepage": "http://www.doctrine-project.org",
    "license": "MIT",
    "authors": [
        {
            "name": "Guilherme Blanco",
            "email": "guilhermeblanco@gmail.com"
        },
        {
            "name": "Roman Borschel",
            "email": "roman@code-factory.org"
        },
        {
            "name": "Benjamin Eberlei",
            "email": "kontakt@beberlei.de"
        },
        {
            "name": "Jonathan Wage",
            "email": "jonwage@gmail.com"
        }
    ],
    "require": {
        "php": ">=5.3.2",
        "ext-pdo": "*",
        "doctrine/collections": "~1.1",
        "doctrine/dbal": "~2.4",
        "symfony/console": "~2.0"
    },
    "autoload": {
        "psr-0": {
            "Doctrine\\ORM\\": "lib/"
        }
    },
    "bin": [
        "bin/doctrine",
        "bin/doctrine.php"
    ],
    "replace": {
        "doctrine/orm": "2.4.8"
    },
    "support": {
        "issues": "https://github.com/nobuhiko/orm/issues"
    }
}
